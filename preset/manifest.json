  "knowledge": ["knowledge/cdmo-lifecycle.md", "knowledge/email-style-guide.md"],
  "commands": [
    {"name":"new-project","label":"新建项目","workflow":"workflows/new-project.md","mode":"analysis"},
    {"name":"meeting-minutes","label":"整理会议纪要","workflow":"workflows/meeting-minutes.md","mode":"analysis"},
    {"name":"weekly-review","label":"生成项目周报","workflow":"workflows/weekly-review.md","mode":"analysis"}
