    "draftFirst": true,
    "requirePmReviewFor": ["client_commitment", "schedule_delay", "quality_event", "deviation", "oos", "capa", "contract", "pricing", "batch_release", "regulatory"],
    "neverInventOwnerOrDate": true,
    "preserveSource": true
  },
  "integrationPlan": "preset/enterprise-integration-plan.md",
