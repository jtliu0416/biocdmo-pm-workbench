{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "biocdmo-pm-harness",
  "version": "0.1.0",
  "displayName": "BioCDMO PM Harness",
  "description": "面向生物药 CDMO 项目经理的项目控制塔 preset。",
  "locale": "zh-CN",
  "systemPrompt": "preset/system-prompt.md",
  "projectSchema": "preset/project-schema.json",
